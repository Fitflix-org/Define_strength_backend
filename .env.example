# Backend Environment Variables
NODE_ENV=development
PORT=3001

# Database URL (Supabase)
DATABASE_URL="postgresql://username:password@db.supabase.co:5432/postgres"

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-at-least-32-characters-long

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# Admin Security (Production only)
ADMIN_IP_WHITELIST=192.168.1.100,10.0.0.5
# Example: ADMIN_IP_WHITELIST=192.168.1.100,10.0.0.5,203.0.113.12
